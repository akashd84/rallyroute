NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: exact browser origin for a remote development tunnel.
RALLYROUTE_DEV_ORIGIN=

# Server-only routing. Set the URL of your self-hosted Valhalla service.
ROUTING_PROVIDER=valhalla
VALHALLA_URL=http://192.168.68.100:8002
# Optional: 1–60000 ms; default 10000.
VALHALLA_TIMEOUT_MS=10000

# Server-only Geoapify key. Required to resolve saved addresses to coordinates.
GEOAPIFY_API_KEY=
# Optional endpoint override for a trusted internal geocoder or test mock.
GEOAPIFY_API_URL=

# Server-only secret API key (sb_secret_...): required for private provider/routing RPCs.
SUPABASE_SECRET_KEY=
# Optional: bump after routing logic/provider tiles change; defaults to 1.
ROUTE_CACHE_VERSION=1
# Optional: straight-line household pickup prefilter; 1,000–250,000 meters.
ROUTING_PREFILTER_MAX_PICKUP_DISTANCE_METERS=100000

# Shared provider controls; positive integers within documented bounds.
GEOCODING_REQUESTS_PER_MINUTE=10
GEOCODING_REQUESTS_PER_HOUR=50
ROUTING_REQUESTS_PER_MINUTE=60
ROUTING_REQUESTS_PER_HOUR=100000
ROUTING_MAX_CONCURRENT_REQUESTS=4
